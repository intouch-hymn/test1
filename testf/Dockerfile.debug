# Build stage
FROM node:18-alpine as build-stage

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# Debug build output
RUN echo "=== BUILD DIST ===" && ls -la dist/ || echo "NO DIST FOLDER"
RUN echo "=== BUILD ASSETS ===" && ls -la dist/assets/ || echo "NO ASSETS FOLDER"
RUN echo "=== DIST CONTENTS ===" && find dist/ -type f || echo "NO FILES"

# Production stage
FROM nginx:alpine as production-stage

COPY --from=build-stage /app/dist /usr/share/nginx/html

# Debug copy result
RUN echo "=== NGINX ROOT ===" && ls -la /usr/share/nginx/html/
RUN echo "=== NGINX ASSETS ===" && ls -la /usr/share/nginx/html/assets/ || echo "NO ASSETS COPIED"

COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]